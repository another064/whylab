# 复制为 .env 后按需修改；.env 已被 .gitignore 忽略，绝不提交真实密钥。
#
# 后端监听端口。前端开发服务器固定 5173，并把 /api 代理到这里。
PORT=3001

# SQLite 数据库文件（相对仓库根目录）。目录不存在会自动创建，文件已被 .gitignore 忽略。
DB_PATH=data/whylab.db

# 模型提供商：mock = 不调用任何外部模型（默认，用于界面联调）
#              openai-compatible = 兼容 OpenAI Chat Completions 的接口
AI_PROVIDER=mock

# 以下三项仅在 AI_PROVIDER=openai-compatible 时生效。
# 修改 AI_PROVIDER 之前请先确认：请求会把问题内容发送到该服务。
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=
AI_API_KEY=
